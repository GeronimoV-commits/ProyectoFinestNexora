-- Crea la base si todavía no existe y la selecciona para las instrucciones siguientes.
CREATE DATABASE IF NOT EXISTS proyecto2;

USE proyecto2;

-- Categorías que se pueden asociar a productos; estado permite desactivarlas sin borrarlas.
CREATE TABLE categorias (
	id INT PRIMARY KEY AUTO_INCREMENT,
	nombre VARCHAR(50) NOT NULL,
	descripcion TEXT,
	estado BOOLEAN NOT NULL DEFAULT TRUE
);

-- Catálogo de productos. categoria referencia la tabla categorias.
CREATE TABLE productos (
	id INT PRIMARY KEY AUTO_INCREMENT,
	nombre VARCHAR(50) NOT NULL,
	descripcion TEXT,
	precio DECIMAL(10,2) NOT NULL,
	stock INT NOT NULL DEFAULT 0,
	imagen VARCHAR(255),
	categoria INT,
	estado BOOLEAN NOT NULL DEFAULT TRUE,
	FOREIGN KEY (categoria) REFERENCES categorias(id)
);

-- Cuentas del sistema; el correo es único y la contraseña almacena un hash.
CREATE TABLE usuarios (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(50) NOT NULL,
    apellido VARCHAR(50) NOT NULL,
    contacto VARCHAR(30),
    email VARCHAR(100) NOT NULL UNIQUE,
    password VARCHAR(255) NOT NULL,
    imagen VARCHAR(255),
    tipo_usuario ENUM('admin', 'user') NOT NULL DEFAULT 'user',
    estado BOOLEAN NOT NULL DEFAULT TRUE
);

